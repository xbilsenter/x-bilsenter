{
  "name": "X Bilsenter (site + CRM)",
  "repositoryDependencies": ["github.com/xbilsenter/x-bilsenter-admin"],
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "admin-crm (8090)",
      "command": "cd ../x-bilsenter-admin/server && NODE_ENV=production node index.js"
    },
    {
      "name": "site-web (8080)",
      "command": "NODE_ENV=production node server/index.js"
    }
  ],
  "ports": [
    { "name": "site-web", "port": 8080 },
    { "name": "admin-crm", "port": 8090 },
    { "name": "admin-vite-dev", "port": 5173 },
    { "name": "site-vite-dev", "port": 5174 }
  ]
}
